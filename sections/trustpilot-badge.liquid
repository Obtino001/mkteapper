{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .tp-badge-wrapper {
    display: flex;
    justify-content: {{ section.settings.alignment }};
    width: 100%;
  }

  .tp-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0; /* Removed background & blur, so horizontal padding is reduced */
    color: rgb(var(--color-foreground)); /* Adapts to your theme's text color */
    font-family: var(--font-body-family), sans-serif;
    text-decoration: none;
  }

  .tp-stars-img {
    height: {{ section.settings.star_height }}px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .tp-badge-text {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.3px;
    line-height: 1;
    padding-top: 1px;
  }
{%- endstyle -%}

<div class="tp-badge-wrapper section-{{ section.id }}-padding">
  <a href="{{ section.settings.badge_link | default: '#' }}" class="tp-badge-pill">
    
    {%- if section.settings.stars_image != blank -%}
      {{ section.settings.stars_image | image_url: height: 100 | image_tag: class: 'tp-stars-img', loading: 'lazy' }}
    {%- endif -%}

    <div class="tp-badge-text">
      {{ section.settings.badge_text }}
    </div>
  </a>
</div>

{% schema %}
{
  "name": "Custom Review Badge",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "stars_image",
      "label": "Stars Image Upload"
    },
    {
      "type": "range",
      "id": "star_height",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Star Image Height",
      "default": 24
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "4,5 stjerner | Baseret på +110 anmeldelser"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Link (Optional)"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Padding settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom Review Badge"
    }
  ]
}
{% endschema %}