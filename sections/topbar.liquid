{% liquid
  assign position = 'left,center,right' | split: ','
%}
<div
  class="topbar section--padding color-{{ section.settings.color_scheme }} page-width page-width--{{ section.settings.container }}{% if section.settings.show_separator_line %} topbar--show-separator-line{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --marquee-duration: {{ section.settings.marquee_speed }}s;"
>
  <div class="topbar__inner grid items-center">
    {% for pos in position %}
      <div class="topbar__column topbar__{{ pos }}{% unless pos == 'center' %} hidden{% else %} flex{% endunless %} lg:flex flex-wrap flex-col lg:flex-row items-center lg:justify-{{ pos | replace: 'left','start' | replace: 'right','end' }} text-center lg:text-{{ pos }}">
        {% for block in section.blocks %}
          {% unless block.settings.position == pos %}
            {% continue %}
          {% endunless %}
          {%- case block.type -%}
            {% when 'link_list' %}
              <ul class="topbar__menu flex flex-wrap items-center justify-center lg:justify-{{ pos | replace: 'left','start' | replace: 'right','end' }}">
                {% for link in linklists[block.settings.menu].links %}
                  <li class="topbar__menu-item">
                    <a href="{{ link.url }}" class="block reversed-link">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>

            {% when 'language_country' %}
              <div class="topbar__country flex items-center gap-4">
                {% liquid
                  if block.settings.show_language_selector
                    render 'language-selector', plain: true, class: 'flex', form_id: block.id
                  endif
                  if block.settings.show_country_selector
                    render 'country-selector', plain: true, class: 'flex', form_id: block.id
                  endif
                %}
              </div>

            {% when 'social_links' %}
              {% liquid
                assign socials = 'facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
                assign show_social = false
                for social in socials
                  assign social_setting = 'show_' | append: social
                  assign social_link = 'social_' | append: social | append: '_link'
                  if block.settings[social_setting] and settings[social_link] != blank
                    assign show_social = true
                    break
                  endif
                endfor
              %}
              {% if show_social %}
                {% render 'social-icons',
                  class: 'topbar__social',
                  size: 'medium',
                  show_facebook: block.settings.show_facebook,
                  show_instagram: block.settings.show_instagram,
                  show_tiktok: block.settings.show_tiktok,
                  show_twitter: block.settings.show_twitter,
                  show_pinterest: block.settings.show_pinterest,
                  show_snapchat: block.settings.show_snapchat,
                  show_tumblr: block.settings.show_tumblr,
                  show_youtube: block.settings.show_youtube,
                  show_vimeo: block.settings.show_vimeo
                %}
              {% endif %}
          {%- endcase -%}
        {% endfor %}

        {% liquid
          assign text_block_count = 0
          for block in section.blocks
            if block.settings.position == pos and block.type == 'text'
              assign text_block_count = text_block_count | plus: 1
            endif
          endfor
        %}

        {% if text_block_count > 0 %}
          {%- comment -%}--- DESKTOP ---{%- endcomment -%}
          <div class="topbar__texts-row topbar__texts-row--desktop">
            {% assign current_text_index = 0 %}
            {% for block in section.blocks %}
              {% if block.settings.position == pos and block.type == 'text' %}
                {% assign current_text_index = current_text_index | plus: 1 %}
                {% if current_text_index > 1 %}
                  <span class="topbar__text-separator"></span>
                {% endif %}
                <div
                  class="topbar__text-item rte"
                  style="--highlight-text-color: {{ block.settings.highlight_text_color }}; --highlight-text-background-color: {{ block.settings.highlight_text_background_color }};"
                  {{ block.shopify_attributes }}
                >
                  <div class="topbar__text-content">
                    {% if block.settings.svg_icon != blank %}
                      <span class="topbar__icon">
                        <img
                          src="{{ block.settings.svg_icon | image_url: width: 60 }}"
                          alt="Icon"
                          loading="lazy"
                        >
                      </span>
                    {% endif %}

                    {% if block.settings.highlight_text != blank %}
                      <span class="highlight-text highlight-text--{{ block.settings.highlight_text_style }}">
                        {{- block.settings.highlight_text -}}
                      </span>
                    {% endif %}
                    <span>{{- block.settings.text -}}</span>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {%- comment -%}--- MOBILE MARQUEE ---{%- endcomment -%}
          <div class="topbar__text-mobile-marquee">
            <div class="marquee">
              <div class="marquee__content">
                {% for i in (1..10) %}
                  {% for block in section.blocks %}
                    {% if block.settings.position == pos and block.type == 'text' %}
                      <span
                        class="marquee__item"
                        style="--highlight-text-color: {{ block.settings.highlight_text_color }}; --highlight-text-background-color: {{ block.settings.highlight_text_background_color }};"
                      >
                        {% if block.settings.svg_icon != blank %}
                          <span class="topbar__icon">
                            <img
                              src="{{ block.settings.svg_icon | image_url: width: 60 }}"
                              alt="Icon"
                              loading="lazy"
                            >
                          </span>
                        {% endif %}

                        {% if block.settings.highlight_text != blank %}
                          <span class="highlight-text highlight-text--{{ block.settings.highlight_text_style }}">
                            {{- block.settings.highlight_text -}}
                          </span>
                        {% endif %}
                        <span>{{- block.settings.text -}}</span>
                      </span>
                    {% endif %}
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .topbar__texts-row--desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .topbar__texts-row--desktop {
      display: inline-flex;
      align-items: center;
      gap: 0;
      flex-wrap: nowrap;
      white-space: nowrap;
    }
  }

  .topbar__text-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .topbar__text-content {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .topbar__text-separator {
    display: inline-flex;
    align-items: center;
    margin: 0 12px;
    opacity: 0.5;
    font-size: 10px;
    flex-shrink: 0;
  }

  .topbar__icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .topbar__icon img {
  width: 23px;   /* change as needed */
  height: 23px;
  object-fit: contain;
}


  .topbar__text-mobile-marquee {
    display: none;
  }

  @media (max-width: 1023px) {
    .topbar__texts-row--desktop {
      display: none !important;
    }

    .topbar__text-mobile-marquee {
      display: block;
      overflow: hidden;
      width: 100%;
    }

    .topbar__text-mobile-marquee::before,
    .topbar__text-mobile-marquee::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 60px;
      z-index: 2;
      pointer-events: none;
    }

    .topbar__text-mobile-marquee::before {
      left: 0;
      background: linear-gradient(to right, rgb(var(--color-background)) 10%, transparent 90%);
    }

    .topbar__text-mobile-marquee::after {
      right: 0;
      background: linear-gradient(to left, rgb(var(--color-background)) 10%, transparent 90%);
    }

    .topbar__inner {
      position: relative;
    }

    .topbar {
      padding-inline: 0;
    }
  }

  /* ==========================================
     MARQUEE - Speed from section setting
     ========================================== */
  .marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .marquee__content {
    display: flex;
    align-items: center;
    animation: scroll var(--marquee-duration, 30s) linear infinite;
    width: fit-content;
    will-change: transform;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 25px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .marquee__item .topbar__icon svg {
    width: 18px;
    height: 18px;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee:hover .marquee__content {
    animation-play-state: paused;
  }
</style>

{% schema %}
{
  "name": "t:sections.top-bar.name",
  "class": "topbar-section z-31",
  "settings": [
    {
      "type": "header",
      "content": "t:general.general.name"
