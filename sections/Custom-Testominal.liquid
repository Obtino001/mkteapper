<style>
  .testimonial-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
  }

  .testimonial-section-{{ section.id }} .testimonial-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .testimonial-section-{{ section.id }} .testimonial-heading {
        font-size: 32px;
    font-weight: 600;
    letter-spacing: 0;
    margin: 0 0 12px 0;
  }

  .testimonial-section-{{ section.id }} .testimonial-subheading {
    font-size: 18px;
    color: #666;
    margin: 0;
  }

  .testimonial-section-{{ section.id }} .testimonial-carousel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .testimonial-section-{{ section.id }} .testimonial-carousel-wrapper::before,
  .testimonial-section-{{ section.id }} .testimonial-carousel-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 150px;
    z-index: 2;
    pointer-events: none;
  }

  .testimonial-section-{{ section.id }} .testimonial-carousel-wrapper::before {
    left: 0;
    background: linear-gradient(to right, {{ section.settings.bg_color }}, transparent);
  }

  .testimonial-section-{{ section.id }} .testimonial-carousel-wrapper::after {
    right: 0;
    background: linear-gradient(to left, {{ section.settings.bg_color }}, transparent);
  }

  .testimonial-section-{{ section.id }} .testimonial-track {
    display: flex;
    gap: 24px;
    animation: scroll-left 40s linear infinite;
    width: fit-content;
  }

  .testimonial-section-{{ section.id }} .testimonial-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .testimonial-section-{{ section.id }} .testimonial-card {
    padding: 20px 28px;
    min-width: 380px;
    max-width: 380px;
    flex-shrink: 0;
    border: 1px solid #EAEAEA;
    border-radius: 8px;
    background-color: #fff;
    box-sizing: border-box;
  }
  .testimonial-section-{{ section.id }} .stars {
    width: 100px;
    margin-bottom: 10px;
  }
  .testimonial-section-{{ section.id }} .star-rating {
    display: flex;
    gap: 4px;
    margin-bottom: 0px;
  }

  .testimonial-section-{{ section.id }} .star-rating svg {
    width: 24px;
    height: 24px;
    fill: #00b67a;
  }

  .testimonial-section-{{ section.id }} .testimonial-text {
    font-size: 12px;
    line-height: 1.6;
    color: #333;
    margin: 0 0 10px 0;
  }

  .testimonial-section-{{ section.id }} .testimonial-author {
    font-size: 12px;
    font-weight: 600;
    color: #000;
    margin: 0;
  }
  .tax-note.text-sm-extra {
    display: none;
}
form.drawer__footer-buttons a {
    display: none;
}

  @media screen and (max-width: 768px) {
    .testimonial-section-{{ section.id }} .testimonial-heading {
      font-size: 28px;
    }

    .testimonial-section-{{ section.id }} .testimonial-subheading {
      font-size: 16px;
    }

    .testimonial-section-{{ section.id }} .testimonial-card {
      min-width: 320px;
      max-width: 320px;
      padding: 24px 20px;
    }

    .testimonial-section-{{ section.id }} .testimonial-carousel-wrapper::before,
    .testimonial-section-{{ section.id }} .testimonial-carousel-wrapper::after {
      width: 80px;
    }
  }
</style>

<div class="testimonial-section-{{ section.id }}">
  <div class="page-width">
    <div class="testimonial-header">
      <h2 class="testimonial-heading">{{ section.settings.heading }}</h2>
      <p class="testimonial-subheading">{{ section.settings.subheading }}</p>
    </div>
  </div>

  <div class="testimonial-carousel-wrapper">
    <div class="testimonial-track">
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="star-rating">
            {% if section.settings.star_image != blank %}
              <img class="stars" src="{{ section.settings.star_image | img_url: 'master' }}" alt="{{ section.settings.star_image.alt | default: '5 stars' }}" loading="lazy">
            {% else %}
              {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              {% endfor %}
            {% endif %}
          </div>
          <p class="testimonial-text">{{ block.settings.review_text }}</p>
          <p class="testimonial-author">{{ block.settings.customer_name }}</p>
        </div>
      {% endfor %}
      
      <!-- Duplicate for seamless loop -->
      {% for block in section.blocks %}
        <div class="testimonial-card">
          <div class="star-rating">
            {% if section.settings.star_image != blank %}
              <img class="stars" src="{{ section.settings.star_image | img_url: 'master' }}" alt="{{ section.settings.star_image.alt | default: '5 stars' }}" loading="lazy">
            {% else %}
              {% for i in (1..5) %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              {% endfor %}
            {% endif %}
          </div>
          <p class="testimonial-text">{{ block.settings.review_text }}</p>
          <p class="testimonial-author">{{ block.settings.customer_name }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
