{%- if block.settings.heading != blank or block.settings.description != blank or block.settings.show_payment_icons -%}
  <div class="product__payment-info flex flex-col gap-4 blocks-radius color-{{ block.settings.color_scheme }}">
    {%- if block.settings.heading != blank -%}
      <div class="product__promotion-alert-heading {{ block.settings.heading_size }}">
        {% render 'highlight-text',
          hl_text: block.settings.heading,
          hl_style: block.settings.highlight_style,
          hl_font_style: block.settings.highlight_font_style,
          hl_style_color: block.settings.highlight_style_color,
          hl_text_color: block.settings.highlight_text_color
        %}
      </div>
    {%- endif -%}
    {%- if block.settings.show_payment_icons -%}
      <span class="visually-hidden">{{ 'general.payment.methods' | t }}</span>
      <ul class="list flex flex-wrap" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li class="flex items-center">
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          </li>
        {%- endfor -%}

        <li class="flex items-center">
          <!-- VIABILL SVG -->
         <svg xmlns="http://www.w3.org/2000/svg" width="38" height="24" viewBox="0 0 38 24" role="img" aria-labelledby="pi-viabill"><title id="pi-viabill">ViaBill</title><path fill="#000" opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z"/><path fill="#5a00ff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/><g fill="#fff"><path d="M24.048 8.885a.676.676 0 0 0-.676.676v4.877a.676.676 0 0 0 1.352 0V9.561a.676.676 0 0 0-.676-.676ZM22.419 13.133a1.691 1.691 0 0 0-1.031-1.52 1.3 1.3 0 0 0 .443-1.016c0-1.139-.964-1.665-2.13-1.665h-1.612a.592.592 0 0 0 0 1.183h1.612c.517 0 .78.263.78.622s-.263.578-.8.578h-.647a.57.57 0 1 0 .021 1.139h1.239a.752.752 0 0 1 .812.765c0 .571-.688.71-1.038.719a.572.572 0 0 0-.11 1.136 2.361 2.361 0 0 0 .392.04 2.166 2.166 0 0 0 1.131-.281 1.864 1.864 0 0 0 .938-1.7ZM12.129 8.885a.676.676 0 0 1 .625.935l-2.016 4.877a.676.676 0 0 1-.625.418.676.676 0 0 1-.625-.935l2.016-4.877a.677.677 0 0 1 .625-.418ZM17.568 15.114a.677.677 0 0 1-.625-.418l-1.637-4.168-1.637 4.168a.676.676 0 0 1-.625.418.676.676 0 0 1-.625-.935l1.922-4.649a1.045 1.045 0 0 1 .965-.645 1.045 1.045 0 0 1 .965.645l1.922 4.649a.676.676 0 0 1-.625.935ZM4.677 8.885a.677.677 0 0 1 .625.418l1.637 4.168 1.637-4.168a.677.677 0 0 1 .625-.418.676.676 0 0 1 .625.935l-1.922 4.649a1.045 1.045 0 0 1-.965.645 1.044 1.044 0 0 1-.965-.645L4.052 9.82a.676.676 0 0 1 .625-.935ZM33.409 13.884h-1.637V9.565a.681.681 0 1 0-1.361 0v4.91a.591.591 0 0 0 .591.591h2.406a.591.591 0 0 0 .591-.591.591.591 0 0 0-.59-.591ZM28.876 13.884h-1.637V9.565a.681.681 0 1 0-1.361 0v4.91a.591.591 0 0 0 .591.591h2.407a.591.591 0 0 0 .591-.591.591.591 0 0 0-.591-.591Z"/></g></svg>
